root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

# Markdown ends a line with two spaces to break it.
[*.md]
trim_trailing_whitespace = false

# Bun writes bun.lock with two-space indents.
[bun.lock]
indent_size = 2
