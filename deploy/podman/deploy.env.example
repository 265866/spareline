# Copy to ~/services/spareline/deploy.env to change update behavior.

# Image to run. The default is the public image built from main.
#UPSTREAM=ghcr.io/265866/spareline:main

# Hour (0-23, in MAINTENANCE_TZ) in which update.sh may apply a new image.
# Empty applies a new image as soon as the hourly check finds it. Set it, for
# example to 22, to keep updates out of the hours the phones are used.
MAINTENANCE_HOUR=
# A tz database name such as Europe/Berlin; empty uses the host's time zone.
MAINTENANCE_TZ=

# The device smoke a new image must pass before it goes live needs at least
# this many online phones. Set 0 to update while every phone is unplugged.
SMOKE_MIN_PHONES=1
