# Copy to ~/services/spareline/app.env (install.sh does this once) to change
# the app's settings. The variables are listed in the main README.

# A name for this host, stored on each phone it sees.
SITE=local

# Phone rules to check and enforce (see "Phone health and rules" in the main
# README).
# Without one, spareline checks no settings on the phones. The image ships
# the examples under /app/profiles/.
#POLICY_PROFILE=/app/profiles/no-data.json
