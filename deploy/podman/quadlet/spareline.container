[Unit]
Description=spareline: inventory, SMS API, and screens for USB phones
# The adb server owns USB on the host; the container only talks to it.
Wants=spareline-adb.service
After=spareline-adb.service

[Container]
Image=localhost/spareline:current
Pull=never
ContainerName=spareline
UserNS=keep-id:uid=10001,gid=10001
User=10001
Group=10001
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
# pasta forwards only the container's port 5037 to the host's loopback, where
# spareline-adb.service listens. Network=host would expose every host-local
# service to the container.
Network=pasta:-T,5037
# Loopback only: a reverse proxy on the host (such as tailscale serve or
# Caddy) is the only way in.
PublishPort=127.0.0.1:8740:8740
Environment=ADB_SERVER=127.0.0.1:5037
# Settings for the app (SITE and the variables in the main README).
EnvironmentFile=%h/services/spareline/app.env
Volume=%h/services/spareline/data:/app/data
LogDriver=k8s-file
LogOpt=max-size=10mb
LogOpt=path=%h/services/spareline/logs/container.log
HealthCmd=bun -e 'const r=await fetch("http://127.0.0.1:8740/healthz");if(!r.ok)process.exit(1)'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy
StopTimeout=25
# Sized for a Raspberry Pi with 2 GB of RAM; raise it on a larger host.
PodmanArgs=--memory=700m

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=default.target
